# Copy to backend/.env — never commit the real file.

# Provider: auto | earthengine | sandbox
SYLVASENSE_PROVIDER=auto

# --- Earth Engine (required for real satellite data) ---
# SYLVASENSE_EE_SERVICE_ACCOUNT_FILE=/abs/path/to/service-account.json
# SYLVASENSE_EE_PROJECT=my-gcp-project

# --- Service ---
SYLVASENSE_HOST=127.0.0.1
SYLVASENSE_PORT=8000
SYLVASENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Analysis tuning ---
SYLVASENSE_MAX_AOI_KM2=2500
SYLVASENSE_ANALYSIS_SCALE_M=30
SYLVASENSE_MIN_GEDI_SAMPLES=40
